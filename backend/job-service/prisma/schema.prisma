generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Job {
  id          String   @id @default(uuid())
  title       String
  description String
  company     String
  location    String
  salaryRange String?
  type        String   @default("full-time") // full-time, part-time, contract
  postedBy    String   // userId of the recruiter
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
